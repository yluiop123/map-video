%% MapVideo V2 核心 E-R 图（数据源：docs/db-schema-v2.sql / src/types/index.ts）
%% 用法：直接以 ```mermaid 代码块嵌入 docs/db-redesign.md（Markdown 渲染器原生支持，不再预渲染 SVG）
%% 2026-09-10 改版：元素表由「element 基表 + 13 子表」改为 4 张类别宽表；图片类下线；疆域内部实体 JSON 内联。
%% 2026-09-13 精简：15 表 / 3 视图；project_config 并入 project；overlay_block / person_block 删除（内容块内联）；
%%              元素动画关键帧早已内联 keyframes_json（无 element_keyframe 表）；派生字段不入库。
%% 2026-09-19 公共图层库：+ public_layer 与 5 张同构副本表 = 22 表。副本脱离项目独立存在，
%%              副本 asset_id 是弱引用；element_id 为全库主键，副本一律加后缀避免撞车。
%% 2026-09-19 底图 / 高程图入库：+ base_map / elevation_map（每项目一份，复合主键），
%%              project.elevation_exaggeration 覆盖值随之删除（夸张系数直接落在行上）。
%% 2026-09-19 连接线（connector）整条下线：删除 from/to_element_id 端点弱引用与 animated/arrowhead，
%%              它是唯一「元素引用元素」的边，去掉后元素表之间不再有互相指向的关系。
erDiagram
  COLLECTION {
    text collection_id PK
    text name
    int ord
  }
  PROJECT {
    text project_id PK
    text collection_id FK
    text name
    text projection
    text active_base_map_id "弱引用 base_map"
    text active_elevation_map_id "弱引用 elevation_map"
    real default_duration_sec
    int default_fps
    int resolution_w
    int resolution_h
    text default_easing
  }
  BASE_MAP {
    text project_id PK_FK
    text base_map_id PK "同项目内唯一，内置 id 各项目同名"
    text name
    text style_url "与 style_json 二选一"
    text style_json "内联样式对象"
    int ord
  }
  ELEVATION_MAP {
    text project_id PK_FK
    text elevation_map_id PK "同项目内唯一"
    text name
    text url "空串=无高程"
    text encoding "mapbox 或 terrarium"
    real exaggeration "地形夸张 0..50 空=默认1.5"
    text style_url
    int ord
  }
  LAYER {
    text layer_id PK
    text project_id FK
    text type "marker|route|shape|territory|image"
    text name
    int visible
    real start_sec
    real end_sec
    int ord
  }
  ELEMENT_MARKER {
    text element_id PK
    text project_id FK
    text type "point|flag|military_symbol"
    text shape "9 种形态"
    text label_text
    text asset_id FK "上传的图片/GIF/模型"
    text builtin_id "内置资源 id"
    text icon_lib "图标库"
    real lng
    real lat
  }
  ELEMENT_ROUTE {
    text element_id PK
    text project_id FK
    text type "line|moving_point"
    text coords_json "坐标集合（唯一保留 JSON 的几何）"
    text move_icon_shape
  }
  ELEMENT_SHAPE {
    text element_id PK
    text project_id FK
    text type "polygon|arrow|double_arrow|gathering|encirclement"
    text rings_json "坐标集合（poly）"
    text move_icon_shape
  }
  ELEMENT_TERRITORY {
    text element_id PK
    text project_id FK
    text type "territory"
    text countries_json
    text plots_json
    text events_json
  }
  ELEMENT_IMAGE {
    text element_id PK
    text project_id FK
    text type "geo_image"
    text asset_id "全局素材库 弱引用"
    int cols
    int rows
    text grid_json "控制点网格"
    real opacity
  }
  CAMERA_KEYFRAME {
    text kf_id PK
    text project_id FK
    text follow_route_element_id FK
  }
  ASSET {
    text asset_id PK
    text kind "icon|image|gif|model|audio|video|font"
    text name
    text storage
  }
  SCREEN_FX {
    text fx_id PK
    text project_id FK
    text kind
  }
  NARRATION {
    text project_id PK
    real font_size
  }
  NARRATION_ENTRY {
    text entry_id PK
    text project_id FK
  }
  MUSIC_TRACK {
    text track_id PK
    text project_id FK
  }
  OVERLAY {
    text overlay_id PK
    text project_id FK
    text type
    text payload_json "custom/person 内容块 + 类型载荷"
  }
  PROVIDER_TEMPLATE {
    text tpl_id PK "一行 = 一份完整模板"
    text category "llm | tts | image"
    text name "用户自填的单个字符串"
    integer use_clone "有没有克隆接口"
    integer upload "克隆前要不要先传拿 fileId"
    text instance_params_json "实例级参数声明"
    text sync_json "同步 submit"
    text async_json "异步 submit + query（含 successValues / failureValues）"
    text download_json "桥接：fileId → 下载地址"
    text upload_json "桥接：本地文件 → fileId"
    text clone_json "参考音频 → voiceId"
    integer ref_sample_rate "克隆参考音频采样率 Hz"
  }
  PROVIDER {
    text provider_id PK "一份模板可挂多条实例"
    text tpl_id FK "引用哪份模板（真外键）"
    text name "实例名"
    integer sync "走 sync_json 还是 async_json"
    text values_json "{ instance：整实例共用取值, requests：按请求各存的取值 }（密钥也在里面）"
  }
  VOICE {
    text voice_row_id PK
    text provider_id FK "音色池按实例隔离（CASCADE）"
    text source_hash "参考音频哈希（幂等键一维）"
    text target_model "voiceId 绑模型（幂等键二维）"
    text source_asset_id FK "原件（RESTRICT：删素材会被拦）"
    text voice_id "厂商音色 ID"
    text status "cloning | ready | failed | expired"
  }
  TASK {
    text task_id PK
    text batch_id "一次「全部生成配音」= 一批"
    text provider_id FK
    text project_id FK "删项目带走在途任务"
    text entry_id FK "回填到哪条字幕"
    text category "tts | image"
    text status "submitting | querying | success | failed | canceled"
    text provider_task_id "厂商任务 id"
    text artifact_id FK "产物落 asset 后回填（SET NULL）"
    integer next_query_at "调度器按它错峰"
  }
  PUBLIC_LAYER {
    text public_layer_id PK
    text type "marker|route|shape|territory|image"
    text name
    int visible
    real start_sec "沿用源图层区间，不归零"
    real end_sec
    int ord
  }
  PUBLIC_ELEMENT_MARKER {
    text element_id PK
    text public_layer_id FK
    text type "point|flag|military_symbol"
    text asset_id "弱引用：公共库不属任何项目"
  }
  PUBLIC_ELEMENT_ROUTE {
    text element_id PK
    text public_layer_id FK
    text type "line|moving_point"
  }
  PUBLIC_ELEMENT_SHAPE {
    text element_id PK
    text public_layer_id FK
    text type "polygon|arrow|double_arrow|gathering|encirclement"
  }
  PUBLIC_ELEMENT_TERRITORY {
    text element_id PK
    text public_layer_id FK
    text type "territory"
    text countries_json
    text plots_json
    text events_json
  }
  PUBLIC_ELEMENT_IMAGE {
    text element_id PK
    text public_layer_id FK
    text type "geo_image"
    text asset_id "弱引用"
    text grid_json
  }
  COLLECTION ||--o{ PROJECT : "1:N 项目"
  PROJECT ||--o{ ASSET : "1:N 素材（含 icon/image 库条目）"
  PROJECT ||--o{ LAYER : "1:N 图层"
  LAYER ||--o{ ELEMENT_MARKER : "1:N 标记"
  LAYER ||--o{ ELEMENT_ROUTE : "1:N 路线"
  LAYER ||--o{ ELEMENT_SHAPE : "1:N 形状"
  LAYER ||--o{ ELEMENT_TERRITORY : "1:N 疆域"
  LAYER ||--o{ ELEMENT_IMAGE : "1:N 贴图"
  PROJECT ||--o{ CAMERA_KEYFRAME : "1:N 视角关键帧"
  PROJECT ||--o{ SCREEN_FX : "1:N 特效窗口"
  PROJECT ||--|| NARRATION : "1:1 字幕档"
  PROJECT ||--o{ NARRATION_ENTRY : "1:N 字幕条"
  PROJECT ||--o{ MUSIC_TRACK : "1:N 配乐"
  PROJECT ||--o{ OVERLAY : "1:N 弹窗"
  PROJECT ||--o{ BASE_MAP : "1:N 底图目录 每项目一份"
  PROJECT ||--o{ ELEVATION_MAP : "1:N 高程目录 每项目一份"
  ELEMENT_MARKER }o--o| ASSET : "媒体资源 asset_id"
  ELEMENT_ROUTE }o--o| ASSET : "移动标记 asset_id"
  ELEMENT_SHAPE }o--o| ASSET : "移动标记 asset_id"
  CAMERA_KEYFRAME }o--o| ELEMENT_ROUTE : "跟随机位 SET NULL"
  PUBLIC_LAYER ||--o{ PUBLIC_ELEMENT_MARKER : "1:N 标记副本"
  PUBLIC_LAYER ||--o{ PUBLIC_ELEMENT_ROUTE : "1:N 路线副本"
  PUBLIC_LAYER ||--o{ PUBLIC_ELEMENT_SHAPE : "1:N 形状副本"
  PUBLIC_LAYER ||--o{ PUBLIC_ELEMENT_TERRITORY : "1:N 疆域副本"
  PUBLIC_LAYER ||--o{ PUBLIC_ELEMENT_IMAGE : "1:N 贴图副本"
  LAYER ||--o{ PUBLIC_LAYER : "整层复制（应用层 INSERT..SELECT，非外键）"
  PROVIDER_TEMPLATE ||--o{ PROVIDER : "1:N 一份模板配几套账号（tpl_id 真外键，被引用时删不掉）"
  PROVIDER ||--o{ VOICE : "1:N 音色池按实例隔离（CASCADE）"
  ASSET ||--o{ VOICE : "1:N 参考音频原件（RESTRICT：被音色引用的素材删不掉）"
  PROVIDER ||--o{ TASK : "1:N 这条实例发出去的在途任务"
  PROJECT ||--o{ TASK : "1:N 删项目带走在途任务（CASCADE）"
  NARRATION_ENTRY ||--o{ TASK : "1:N 回填到哪条字幕（CASCADE）"
  ASSET ||--o{ TASK : "1:N 产物落 asset 后回填（SET NULL）"
