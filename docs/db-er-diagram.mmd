%% MapVideo V2 核心 E-R 图（数据源：docs/db-schema-v2.sql / src/types/index.ts）
%% 用法：直接以 ```mermaid 代码块嵌入 docs/db-redesign.md（Markdown 渲染器原生支持，不再预渲染 SVG）
%% 2026-09-10 改版：元素表由「element 基表 + 13 子表」改为 4 张类别宽表；图片类下线；疆域内部实体 JSON 内联。
%% 2026-09-13 精简：15 表 / 3 视图；project_config 并入 project；overlay_block / person_block 删除（内容块内联）；
%%              元素动画关键帧早已内联 keyframes_json（无 element_keyframe 表）；派生字段不入库。
erDiagram
  COLLECTION {
    text collection_id PK
    text name
    int ord
  }
  PROJECT {
    text project_id PK
    text collection_id FK
    text name
    text projection
    text active_base_map_id
    real default_duration_sec
    int default_fps
    int resolution_w
    int resolution_h
    text default_easing
    real elevation_exaggeration "地形夸张覆盖值 空=用内置默认"
    real end_sec "全片总长（秒）"
  }
  ELEMENT_MARKER {
    text element_id PK
    text project_id FK
    text type "point|flag|military_symbol"
    text shape "9 种形态"
    text label_text
    text asset_id FK "上传的图片/GIF/模型"
    text builtin_id "内置资源 id"
    text icon_lib "图标库"
    real lng
    real lat
  }
  ELEMENT_ROUTE {
    text element_id PK
    text project_id FK
    text type "line|moving_point|connector"
    text coords_json "坐标集合（唯一保留 JSON 的几何）"
    text move_icon_shape
    text from_element_id "弱引用"
    text to_element_id "弱引用"
  }
  ELEMENT_SHAPE {
    text element_id PK
    text project_id FK
    text type "polygon|arrow|double_arrow|gathering|encirclement"
    text rings_json "坐标集合（poly）"
    text move_icon_shape
  }
  ELEMENT_TERRITORY {
    text element_id PK
    text project_id FK
    text type "territory"
    text countries_json
    text plots_json
    text events_json
  }
  CAMERA_KEYFRAME {
    text kf_id PK
    text project_id FK
    text follow_route_element_id FK
  }
  ASSET {
    text asset_id PK
    text kind "icon|image|gif|model|audio|video|font"
    text name
    text storage
  }
  SCREEN_FX {
    text fx_id PK
    text project_id FK
    text kind
  }
  NARRATION {
    text project_id PK
    real font_size
  }
  NARRATION_ENTRY {
    text entry_id PK
    text project_id FK
  }
  MUSIC_TRACK {
    text track_id PK
    text project_id FK
  }
  OVERLAY {
    text overlay_id PK
    text project_id FK
    text type
    text payload_json "custom/person 内容块 + 类型载荷"
  }
  PROVIDER {
    text provider_id PK
    text kind
    int active
  }
  COLLECTION ||--o{ PROJECT : "1:N 项目"
  PROJECT ||--o{ ASSET : "1:N 素材（含 icon/image 库条目）"
  PROJECT ||--o{ ELEMENT_MARKER : "1:N 标记(Pin)"
  PROJECT ||--o{ ELEMENT_ROUTE : "1:N 路线(Route)"
  PROJECT ||--o{ ELEMENT_SHAPE : "1:N 形状(Shape)"
  PROJECT ||--o{ ELEMENT_TERRITORY : "1:N 疆域(Terr)"
  PROJECT ||--o{ CAMERA_KEYFRAME : "1:N 视角关键帧"
  PROJECT ||--o{ SCREEN_FX : "1:N 特效窗口"
  PROJECT ||--|| NARRATION : "1:1 字幕档"
  PROJECT ||--o{ NARRATION_ENTRY : "1:N 字幕条"
  PROJECT ||--o{ MUSIC_TRACK : "1:N 配乐"
  PROJECT ||--o{ OVERLAY : "1:N 弹窗"
  ELEMENT_MARKER }o--o| ASSET : "媒体资源 asset_id"
  ELEMENT_ROUTE }o--o| ASSET : "移动标记 asset_id"
  ELEMENT_SHAPE }o--o| ASSET : "移动标记 asset_id"
  CAMERA_KEYFRAME }o--o| ELEMENT_ROUTE : "跟随机位 SET NULL"
  ELEMENT_ROUTE }o--o{ ELEMENT_MARKER : "connector 端点 弱引用 无外键"
