%% 2026-09-10 改版：元素表由「element 基表 + 13 子表」改为 4 张类别宽表；图片类下线；疆域内部实体 JSON 内联。
erDiagram
  COLLECTION {
    text collection_id PK
    text name
    int ord
  }
  PROJECT {
    text project_id PK
    text collection_id FK
    text name
    text projection
    text active_base_map_id
  }
  PROJECT_CONFIG {
    text project_id PK
    real default_duration_sec
    int default_fps
    text resolution_label
    text default_easing
    real elevation_exaggeration "地形夸张覆盖值 空=用内置默认"
  }
  CHAPTER {
    text chapter_id PK
    text project_id FK
    int order_index
    real start_sec
  }
  ELEMENT_MARKER {
    text element_id PK
    text chapter_id FK
    text type "point|flag|military_symbol"
    text shape "9 种形态"
    text asset_id FK "上传的图片/GIF/模型"
    text builtin_id "内置资源 id"
    text icon_lib "图标库"
    real lng
    real lat
  }
  ELEMENT_ROUTE {
    text element_id PK
    text chapter_id FK
    text type "line|moving_point|connector"
    text from_element_id "弱引用"
    text to_element_id "弱引用"
  }
  ELEMENT_SHAPE {
    text element_id PK
    text chapter_id FK
    text type "polygon|arrow|double_arrow|gathering|encirclement"
  }
  ELEMENT_TERRITORY {
    text element_id PK
    text chapter_id FK
    text type "territory"
    text countries_json
    text plots_json
    text events_json
  }
  ELEMENT_KEYFRAME {
    text kf_id PK
    text element_id "弱引用"
    text element_type
    text chapter_id FK
    text property
    real sec
  }
  CAMERA_KEYFRAME {
    text kf_id PK
    text chapter_id FK
    text follow_route_element_id FK
  }
  ASSET {
    text asset_id PK
    text project_id FK
    text sha256
    text storage
  }
  CUSTOM_IMAGE {
    text project_id PK
    text asset_id PK
    text name
  }
  OVERLAY {
    text overlay_id PK
    text chapter_id FK
    text type
  }
  PROVIDER {
    text provider_id PK
    text kind
    int active
  }
